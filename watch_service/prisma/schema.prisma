generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model VideoData {
  id            Int     @id @default(autoincrement())
  title         String
  description   String?
  author        String
  url           String
  transcodedUrl String?
  filename      String  @unique
}

model playing_with_neon {
  id    Int    @id @default(autoincrement())
  name  String
  value Float? @db.Real
}
